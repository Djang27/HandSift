{
  "name": "handsift",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @handsift/extension test:e2e",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm depcruise",
    "fixtures:fetch": "jiti scripts/fetch-fixtures.ts",
    "eval": "jiti scripts/eval.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@handsift/shared": "workspace:*",
    "@types/node": "^24.19.1",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "zod": "^4.6.5"
  }
}
